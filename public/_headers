# Keep the Cloudflare Pages preview hosts out of search engines and AI tools.
# These rules match only *.pages.dev hosts; goldenstateglam.com gets no X-Robots-Tag.
https://goldenstateglam.pages.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai

https://:sub.goldenstateglam.pages.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai
