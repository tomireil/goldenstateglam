---
import { nav, site } from '../data/site';
const { path = '/' } = Astro.props;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="logo" href="/" aria-label="Golden State Glam, home">
      <span class="logo__name">Golden State <em>Glam</em></span>
      <span class="logo__tag">Facials &amp; skincare</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="site-header__cta">
      <a class="site-header__phone link" href={site.phoneHref}>{site.phoneDisplay}</a>
      <a class="btn btn--sm" href={site.bookingUrl}>Book now</a>
    </div>
    <details class="menu">
      <summary aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 7h14M3 13h14"></path></svg>
      </summary>
      <nav class="menu__panel" aria-label="Main, mobile">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={site.phoneHref}>Call {site.phoneDisplay}</a>
      </nav>
    </details>
  </div>
</header>
