---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import seo from '../data/seo.json';
import { site } from '../data/site';
import { priceFrom, priceTo, services } from '../data/facials';

interface Props {
  /** Site path with trailing slash, e.g. "/services/". Used to look up title, description and structured data. */
  path: string;
  /** Extra JSON-LD blocks built from the page's own visible content (e.g. FAQ). */
  jsonLd?: object[];
  title?: string;
  description?: string;
  /** Keep this page out of search results (used by the 404 page). */
  noindex?: boolean;
  /** Absolute URL of a 1200x630 preview image. Defaults to the site-wide one. */
  ogImage?: string;
  ogImageAlt?: string;
}

const { path, jsonLd = [], noindex = false } = Astro.props;
const entry = (seo as Record<string, any>)[path] ?? {};
const title = Astro.props.title ?? entry.title ?? site.name;
const description = Astro.props.description || entry.description || '';
const ogType = entry.ogType ?? 'website';
const canonical = new URL(path, site.url).href;
const customOg = Astro.props.ogImage;
const ogImage = customOg ?? `${site.url}/og.jpg`;
const ogImageAlt = Astro.props.ogImageAlt ?? 'Cover portrait for Golden State Glam';
// The business block keeps its stored facts (address, hours, geo). Prices and the service list come from the menu.
const business = {
  ...(seo as Record<string, any>)._business,
  description: `Facials in Fair Oaks, CA, by licensed esthetician ${site.owner}. ${site.name} offers facials, peels and skin treatments from ${priceFrom} to ${priceTo} at one studio. Book online.`,
  priceRange: `${priceFrom}–${priceTo}`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Facials and skin treatments',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Offer',
        name: s.name,
        url: `${site.url}/services/${s.slug}/`,
        priceCurrency: 'USD',
        price: s.offerPrice,
      },
    })),
  },
};
const blocks = [business, ...(entry.jsonld ?? []), ...jsonLd]
  .filter(Boolean)
  // A post with its own preview image uses it in its structured data too.
  .map((b) => (customOg && b['@type'] === 'BlogPosting' ? { ...b, image: customOg } : b));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content={customOg ? '630' : '932'} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#faf5ef" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-language summary of Golden State Glam" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header path={path} />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
