---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base path="/404/" noindex title="Page not found | Golden State Glam" description="That page isn’t here. Find the facial menu, booking and contact details for Golden State Glam in Fair Oaks.">
  <section class="wrap section stack" style="align-items: flex-start">
    <p class="eyebrow eyebrow--rule">Page not found</p>
    <h1 class="display h-page">That page <em>isn’t here</em></h1>
    <p class="lede">The link may be old. The facial menu and booking are one tap away.</p>
    <div class="actions">
      <a class="btn" href="/services/">See the facials</a>
      <a class="btn btn--outline" href={site.bookingUrl}>Book now</a>
    </div>
  </section>
</Base>
