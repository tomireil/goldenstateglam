---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import { formatDate, posts } from '../../data/posts';
import { site } from '../../data/site';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = post;
const path = `/blog/${post.slug}/`;
const more = posts.filter((p) => p.slug !== post.slug).slice(0, 3);

// Posts imported from the old site carry their original structured data in seo.json.
// A new post gets the same two blocks generated here.
import seo from '../../data/seo.json';
const known = (seo as Record<string, any>)[path];
const jsonLd = known
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: post.title,
        description: post.description,
        datePublished: post.pubDate.toISOString(),
        dateModified: post.updatedDate.toISOString(),
        mainEntityOfPage: `${site.url}${path}`,
        url: `${site.url}${path}`,
        image: `${site.url}/og.jpg`,
        author: { '@type': 'Person', '@id': `${site.url}/#owner`, name: site.owner, url: `${site.url}/about/` },
        publisher: { '@type': 'Organization', name: site.name, url: site.url },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
          { '@type': 'ListItem', position: 2, name: 'Journal', item: `${site.url}/blog/` },
          { '@type': 'ListItem', position: 3, name: post.title, item: `${site.url}${path}` },
        ],
      },
    ];

// Preview image for sharing and search: the post's own photo, cropped to 1200x630.
import { getImage } from 'astro:assets';
import { images } from '../../data/images';
const photo = post.image ? images[post.image] : undefined;
const og = photo ? await getImage({ src: photo.src, width: 1200, height: 630, format: 'jpg', quality: 82 }) : undefined;
const ogImage = og ? new URL(og.src, site.url).href : undefined;
---

<Base
  path={path}
  title={known?.title ?? post.title}
  description={known?.description ?? post.description}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogImageAlt={photo?.alt}
>
  <article class="wrap article">
    <header class="stack" style="gap: 22px">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog/">Journal</a>
      </nav>
      <p class="eyebrow eyebrow--rule">Studio note</p>
      <h1 class="display h-page">{post.title}</h1>
      <p class="lede">{post.description}</p>
      <p class="small muted">
        <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time> · {site.owner}, {
          site.ownerTitle.toLowerCase()
        }
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <div class="actions">
      <a class="btn" href={site.bookingUrl}>Book now <Arrow /></a>
      <a class="btn btn--outline" href="/services/">Facial menu</a>
    </div>
  </article>

  <section class="bg-sand">
    <div class="wrap section stack" style="gap: 28px">
      <h2 class="display h-sub">Also in the <em>journal</em></h2>
      <div class="more">
        {
          more.map((p) => (
            <a href={`/blog/${p.slug}/`}>
              <span class="more__title">{p.title}</span>
              <span class="more__desc">{p.description}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <div style="height: var(--section)"></div>
  <CtaBand />
</Base>

<style>
  .article {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 48px);
    max-width: 920px;
    padding-block: clamp(28px, 4vw, 56px) var(--section);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 20px;
  }

  .more a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    background: var(--cream);
    border-radius: 24px;
    text-decoration: none;
  }

  .more__title {
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1.1;
  }

  .more__desc {
    font-size: 15px;
    color: var(--text);
  }
</style>
