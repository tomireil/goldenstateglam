---
// Hydrodermabrasion isn't its own service on the booking menu. It's part of every Signature Deep Cleanse,
// so this page explains it and sends people to that facial. Price and length are read from facials.ts.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import Arrow from '../components/Arrow.astro';
import { faqJsonLd } from '../data/faqs';
import { serviceBySlug, services } from '../data/facials';
import { images } from '../data/images';
import { site } from '../data/site';

const s = serviceBySlug('signature-deep-cleanse');
// Every service whose list of steps includes hydrodermabrasion.
const withIt = services.filter((x) => x.includes.some((i) => /hydroderm/i.test(i)));
const amounts = withIt.map((x) => parseInt(x.price.replace(/\D/g, ''), 10));
const path = '/hydrodermabrasion/';
const title = 'Hydrodermabrasion Facial in Fair Oaks | Golden State Glam';
const description = `Hydrodermabrasion in Fair Oaks with a Zemits machine: a gentle, water-based deep clean. It's part of every facial here, from $${Math.min(...amounts)}.`;

const faqs = [
  {
    q: 'Is this a HydraFacial?',
    a: 'Not by name. HydraFacial is a brand, and only studios with that company’s machine can use the name. I use a Zemits hydrodermabrasion machine. It’s the same kind of water-based treatment from a different brand.',
  },
  {
    q: 'What does hydrodermabrasion cost?',
    a: `There’s no extra charge. It’s part of every facial I do, and those run from $${Math.min(...amounts)} to $${Math.max(...amounts)}. The ${s.name} is ${s.price} for ${s.time}.`,
  },
  {
    q: 'Can I book hydrodermabrasion on its own?',
    a: `It isn’t a separate booking. It’s included in every facial I do. For the deepest clean, book the ${s.name}.`,
  },
  {
    q: 'Is there downtime?',
    a: 'Slight redness after extractions is normal. It usually fades within a few hours.',
  },
  {
    q: 'How often should I come?',
    a: 'Most clients come back every four to six weeks.',
  },
  {
    q: 'How should I prepare?',
    a: 'Skip retinol and exfoliating acids for three days before your visit. When you book, tell me about any allergies, prescriptions, or recent skin treatments.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Facials', item: `${site.url}/services/` },
      { '@type': 'ListItem', position: 3, name: 'Hydrodermabrasion', item: `${site.url}${path}` },
    ],
  },
  faqJsonLd(faqs),
];
---

<Base path={path} title={title} description={description} jsonLd={jsonLd}>
  <section class="hd-hero bg-sand">
    <div class="wrap hd-hero__in">
      <div class="hd-hero__text stack">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/services/">Facials</a><span>/</span><span
            >Hydrodermabrasion</span
          >
        </nav>
        <h1 class="display h-page">Hydrodermabrasion, <em>a water-based deep clean in Fair Oaks</em></h1>
        <p class="lede">
          A gentle, water-based exfoliation that lifts dead skin and debris without scrubbing. I do it with a Zemits
          machine, and it’s part of every facial I do.
        </p>
        <div class="actions">
          <a class="btn" href={site.bookingUrl}>Book now <Arrow /></a>
          <a class="btn btn--outline" href={`/services/${s.slug}/`}>See the facial</a>
        </div>
      </div>
      <div class="hd-hero__photo">
        <Image
          src={images.facialMask.src}
          alt={images.facialMask.alt}
          widths={[420, 640, 840, 1200]}
          sizes="(min-width: 900px) 520px, 100vw"
          loading="eager"
          style={`object-position: ${s.focus}`}
        />
        <div class="hd-hero__tag">
          <strong>{s.price}</strong>
          <span>{s.time} · {s.short}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap hd">
    <div class="hd__cols">
      <div class="stack hd__copy">
        <h2 class="display h-sub">What is <em>hydrodermabrasion?</em></h2>
        <p>
          It’s exfoliation done with water. Nothing gritty is rubbed across your skin. The treatment lifts dead skin
          and debris, which is why skin looks smoother afterward.
        </p>
        <p>
          You may know it by a brand name. HydraFacial is the best known one. My machine is made by Zemits, so I call
          the treatment what it is: hydrodermabrasion.
        </p>
        <p>
          It’s best for {s.bestFor}.
        </p>
      </div>
      <div class="hd__card">
        <p class="eyebrow">What’s in the visit</p>
        <h2 class="hd__card-title">{s.name}</h2>
        <ol>
          {s.includes.map((x) => <li class:list={{ 'is-on': /hydroderm/i.test(x) }}>{x}</li>)}
        </ol>
        <a class="btn hd__card-btn" href={`/services/${s.slug}/`}>
          {s.price} · {s.time} <Arrow />
        </a>
      </div>
    </div>

    <div class="hd__which stack">
      <h2 class="display h-sub">Facials that <em>include it</em></h2>
      <ul>
        {
          withIt.map((x) => (
            <li>
              <a href={`/services/${x.slug}/`}>
                <span class="hd__which-name">{x.name}</span>
                <span class="hd__which-meta">
                  {x.price} · {x.time}
                </span>
                <Arrow />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hd__three">
      <article>
        <span>01</span>
        <h3>Gentle</h3>
        <p>Water does the exfoliating. There’s no scrubbing.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Thorough</h3>
        <p>In the {s.name}, it comes with a double cleanse, extractions where needed and a targeted mask.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Easy to plan</h3>
        <p>Slight redness after extractions usually fades within a few hours.</p>
      </article>
    </div>

    <div class="hd__faq">
      <h2 class="display h-sub">Common <em>questions</em></h2>
      <FaqList items={faqs} />
      <p class="muted small">
        Dry or dehydrated skin instead? See the <a href="/services/korean-glass-skin/">Korean Glass Skin Facial</a>,
        or find <a href="/which-facial/">which facial fits your skin</a>. Facials here are cosmetic skincare, not
        medical treatment, and results vary.
      </p>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .hd-hero {
    border-radius: 0 0 clamp(28px, 4vw, 56px) clamp(28px, 4vw, 56px);
  }

  .hd-hero__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px clamp(32px, 6vw, 88px);
    padding-block: clamp(16px, 2.5vw, 32px) clamp(36px, 5vw, 64px);
  }

  .hd-hero__text {
    flex: 1 1 420px;
    min-width: 0;
    gap: 18px;
  }

  .hd-hero__photo {
    position: relative;
    flex: 1 1 380px;
    min-width: 0;
    aspect-ratio: 5 / 4;
    border-radius: 32px;
    overflow: hidden;
  }

  .hd-hero__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hd-hero__tag {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    padding: 12px 18px;
    border-radius: 18px;
    background: var(--champagne);
    color: var(--ink);
    font-size: 14px;
  }

  .hd-hero__tag strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 30px;
    line-height: 1;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 14px;
    color: var(--text);
  }

  .crumbs a,
  .crumbs span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .hd {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 80px);
    padding-block: clamp(40px, 6vw, 80px) var(--section);
  }

  .hd__cols {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px clamp(32px, 6vw, 88px);
  }

  .hd__copy {
    flex: 1 1 400px;
    min-width: 0;
    gap: 16px;
    color: var(--text-strong);
    font-size: 18px;
  }

  .hd__card {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: 28px;
    background: var(--ink);
    color: var(--ivory);
  }

  .hd__card .eyebrow {
    color: var(--champagne);
  }

  .hd__card-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 32px;
    line-height: 1.1;
    color: var(--ivory);
  }

  .hd__card ol {
    display: flex;
    flex-direction: column;
  }

  .hd__card li {
    padding-block: 10px;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }

  .hd__card li.is-on {
    color: var(--champagne);
    font-weight: 500;
  }

  .hd__card-btn {
    margin-top: 8px;
    align-self: flex-start;
    background: var(--champagne);
    color: var(--ink);
  }

  .hd__which {
    gap: 20px;
  }

  .hd__which ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 12px;
  }

  .hd__which li a {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px 14px;
    min-height: 64px;
    padding: 12px 20px;
    border-radius: 18px;
    background: var(--sand);
    color: var(--ink);
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .hd__which li a:hover {
    background: var(--champagne);
  }

  .hd__which-name {
    flex: 1 1 0;
    min-width: 0;
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1.15;
  }

  .hd__which-meta {
    order: 3;
    flex-basis: 100%;
    font-size: 14px;
    color: var(--text-strong);
  }

  .hd__three {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 20px;
  }

  .hd__three article {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px;
    border-radius: 24px;
    background: var(--sand);
    color: var(--text-strong);
  }

  .hd__three span {
    font-family: var(--serif);
    font-size: 20px;
    color: var(--text-strong);
  }

  .hd__three h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    color: var(--ink);
  }

  .hd__faq {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 820px;
  }

  @media (max-width: 700px) {
    .hd-hero__photo {
      order: -1;
      flex-basis: 100%;
      aspect-ratio: 4 / 3;
    }

    .hd-hero__in {
      padding-top: 20px;
    }
  }
</style>
