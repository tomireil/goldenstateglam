---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import { categories, services, type Service } from '../../data/facials';
import { faqJsonLd, type Faq } from '../../data/faqs';
import { images } from '../../data/images';
import { site } from '../../data/site';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return services.map((service) => {
    // Up to three others: first from the same category.
    const same = services.filter((s) => s.category === service.category && s.slug !== service.slug);
    // Then the services that follow this one on the menu, wrapping round, so every page gets links from others.
    const at = services.indexOf(service);
    const rest = [...services.slice(at + 1), ...services.slice(0, at)].filter((s) => s.category !== service.category);
    return { params: { slug: service.slug }, props: { service, others: [...same, ...rest].slice(0, 3) } };
  });
}

interface Props {
  service: Service;
  others: Service[];
}

const { service: s, others } = Astro.props;
// Journal posts that mention this service.
const related = posts.filter((p) => p.links.includes(s.slug)).slice(0, 3);
const path = `/services/${s.slug}/`;
const pageUrl = `${site.url}${path}`;
const category = categories.find((c) => c.id === s.category)!;

const tabs = [
  { id: 'includes', label: 'What it includes', items: s.includes },
  { id: 'expect', label: 'What to expect', items: s.expect },
  { id: 'know', label: 'Good to know', items: s.goodToKnow },
];

// Questions answered from the booking menu's own numbers.
const priceAnswer = s.price.startsWith('from')
  ? `The published price starts at ${s.price.replace('from ', '')} and the visit is ${s.time}. The final price depends on the option you choose.`
  : `The published price is ${s.price} and the visit is ${s.time}.`;
const faqs: Faq[] = [
  {
    q: `How much is the ${s.name}, and how long is it?`,
    a: `${priceAnswer} Confirm the price and length on the booking screen.`,
  },
  {
    q: 'Is there a deposit?',
    a: s.deposit
      ? `The booking menu lists a ${s.deposit}. Whatever the booking screen shows is the one to follow.`
      : 'The booking menu does not list a deposit for this service. Whatever the booking screen shows is the one to follow.',
  },
];

// Search results cut titles at about 60 characters and descriptions at about 160, so long names get a shorter form.
const fullTitle = `${s.name} in Fair Oaks | ${site.name}`;
const title = fullTitle.length <= 60 ? fullTitle : `${s.name} in Fair Oaks, CA`;
const longDesc = `${s.name} in Fair Oaks: ${s.price} for ${s.time}. ${s.lead}`;
const descBase = longDesc.length <= 160 ? longDesc : `${s.name}: ${s.price}, ${s.time}. ${s.lead}`;
const description = `${descBase}${descBase.length < 132 ? ' Book online.' : ''}`;

const jsonLd = [
  faqJsonLd(faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    serviceType: category.name,
    description: [s.lead, ...(s.intro ?? [])].join(' '),
    url: pageUrl,
    provider: { '@id': `${site.url}/#business` },
    areaServed: { '@type': 'City', name: 'Fair Oaks', containedInPlace: { '@type': 'State', name: 'California' } },
    offers: { '@type': 'Offer', priceCurrency: 'USD', price: s.offerPrice, url: site.bookingUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Facials', item: `${site.url}/services/` },
      { '@type': 'ListItem', position: 3, name: s.name, item: pageUrl },
    ],
  },
];
---

<Base path={path} jsonLd={jsonLd} title={title} description={description}>
  <section class="wrap detail">
    <div class="detail__text stack" style="gap: 24px">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Facials</a><span aria-hidden="true"
          >/</span
        ><span>{s.short}</span>
      </nav>
      <p class="eyebrow eyebrow--rule">{category.name}</p>
      <h1 class="display h-page">{s.name} <em>in Fair Oaks</em></h1>
      <p class="pull">{s.lead}</p>
      {s.intro?.map((p) => <p class="lede">{p}</p>)}
      {s.bestFor && (
        <p class="best">
          <span>Best for</span> {s.bestFor}.
        </p>
      )}

      <div class="tabs" data-tabs>
        <div class="tabs__bar" role="tablist" aria-label="About this service">
          {
            tabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {t.label}
              </button>
            ))
          }
        </div>
        {
          tabs.map((t, i) => (
            <div class="tabs__panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
              <h2 class="sr-only">{t.label}</h2>
              <ul class="checklist">
                {t.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <aside class="detail__aside">
      <Image
        class="detail__photo arch"
        src={images[s.image].src}
        alt={images[s.image].alt}
        widths={[520, 1040]}
        sizes="(min-width: 980px) 520px, 100vw"
        loading="eager"
        style={`object-position: ${s.focus}`}
      />
      <div class="detail__book card">
        <div class:list={['detail__price', { 'detail__price--words': s.price.startsWith('from') }]}>
          <span>{s.price}</span>
          <small>{s.time}</small>
        </div>
        <p class="small muted">{s.deposit ?? 'No deposit listed'}</p>
        <a class="btn btn--lg btn--block" href={site.bookingUrl}>Book this <Arrow /></a>
        <div class="detail__where small">
          <span>{site.street}</span>
          <a class="link" href={site.smsHref}>Text me first</a>
        </div>
      </div>
    </aside>
  </section>

  {
    s.options && (
      <section class="bg-sand">
        <div class="wrap section stack" style="gap: 36px">
          <h2 class="display h-section">
            Choose your <em>peel</em>
          </h2>
          <p class="lede" style="color: var(--text-strong)">
            You pick one of these when you book. The price starts at {s.price.replace('from ', '')} and depends on the
            peel.
          </p>
          <div class="options">
            {s.options.map((o) => (
              <article class="option">
                <h3>{o.name}</h3>
                <p>{o.desc}</p>
                <p class="small muted">Best for: {o.bestFor}.</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="wrap section extra">
    <div class="stack">
      <h2 class="display h-sub">Price and <em>deposit</em></h2>
      <FaqList items={faqs} />
    </div>
    <div class="stack">
      <h2 class="display h-sub">Visiting the <em>studio</em></h2>
      <p class="muted">
        {s.name} is given at one studio: {site.fullAddress}. Clients visit from Folsom, El Dorado Hills, Carmichael and
        Sacramento. {site.hoursLong}.
      </p>
      <p class="muted small">
        Services here are cosmetic skincare, not medical treatment, and results vary. For a medical skin concern, see
        a qualified healthcare professional.
      </p>
      <p class="actions">
        <a class="link" href="/faq/">First-visit questions</a>
        <a class="link" href={site.mapsUrl}>Get directions</a>
      </p>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="wrap journal-links">
        <h2 class="display h-sub">From <em>the journal</em></h2>
        <ul>
          {related.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`}>{p.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="bg-sand">
    <div class="wrap section stack" style="gap: 40px">
      <div class="others__head">
        <h2 class="display h-section">More from <em>the menu</em></h2>
        <a class="link" href="/services/">The full menu</a>
      </div>
      <div class="others">
        {
          others.map((o) => (
            <a class="other" href={`/services/${o.slug}/`}>
              <span class="other__photo">
                <Image
                  src={images[o.image].src}
                  alt={images[o.image].alt}
                  widths={[400, 800]}
                  sizes="(min-width: 980px) 380px, 100vw"
                  style={`object-position: ${o.focus}`}
                />
              </span>
              <span class="other__row">
                <span class="other__name">{o.name}</span>
                <span class="other__meta">
                  {o.price} · {o.time}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <div style="height: var(--section)"></div>
  <CtaBand />
</Base>

<style>
  .detail {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px clamp(36px, 5vw, 72px);
    padding-block: clamp(20px, 3vw, 36px) var(--section);
  }

  .detail__text {
    flex: 1 1 520px;
    min-width: 0;
  }

  .best {
    color: var(--text-strong);
  }

  .best span {
    margin-right: 8px;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .detail__aside {
    flex: 1 1 380px;
    min-width: 0;
    max-width: 520px;
    margin-inline: auto;
  }

  .detail__aside :global(.detail__photo) {
    width: 100%;
    height: clamp(360px, 44vw, 520px);
    object-fit: cover;
  }

  .detail__book {
    position: relative;
    margin: -90px clamp(12px, 2vw, 24px) 0;
    padding: clamp(22px, 3vw, 30px) clamp(20px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .detail__price {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .detail__price span {
    font-family: var(--serif);
    font-size: clamp(44px, 5vw, 56px);
    line-height: 1;
    color: var(--bronze);
  }

  .detail__price--words {
    flex-wrap: wrap;
    gap: 6px 16px;
  }

  .detail__price small {
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .detail__where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    color: var(--text);
  }

  .tabs {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tabs__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 34px;
    border-bottom: 1px solid var(--line);
  }

  .tabs__bar button {
    min-height: 52px;
    padding: 0 0 10px;
    margin-bottom: -1px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    font-family: var(--serif);
    font-size: clamp(21px, 2.2vw, 26px);
    color: var(--muted);
  }

  .tabs__bar button[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--gold);
  }

  .tabs__panel {
    min-height: 190px;
  }

  .options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }

  .option {
    padding: 28px;
    background: var(--cream);
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--text);
  }

  .option h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 27px;
    line-height: 1.05;
    color: var(--ink);
  }

  .extra {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 48px clamp(40px, 6vw, 80px);
    align-items: start;
  }

  .journal-links {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: var(--section);
  }

  .journal-links ul {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .journal-links li {
    border-bottom: 1px solid var(--line);
  }

  .journal-links a {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding-block: 12px;
    font-size: 18px;
    text-decoration: none;
  }

  .journal-links a:hover {
    color: var(--bronze);
  }

  .others__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 40px;
  }

  .others {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 28px;
  }

  .other {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
  }

  .other__photo {
    display: block;
    height: 300px;
    border-radius: 24px;
    overflow: hidden;
  }

  .other__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .other:hover .other__photo :global(img) {
    transform: scale(1.04);
  }

  .other__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
  }

  .other__name {
    font-family: var(--serif);
    font-size: 28px;
    line-height: 1.05;
  }

  .other__meta {
    flex: none;
    font-size: 15px;
    color: var(--text);
  }
</style>

<script>
  // Tabs. All three lists are in the HTML; without this script the first one shows.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    function select(index: number, focus = false) {
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === index));
        t.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((p, i) => (p.hidden = i !== index));
      if (focus) tabs[index].focus();
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
      });
    });
  });
</script>
