---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import {
  categories,
  packageAddOnNote,
  packageAddOns,
  packageDeposit,
  packages,
  packageTerms,
  services,
} from '../../data/facials';
import { images } from '../../data/images';
import { site } from '../../data/site';

const groups = categories.map((c) => ({ ...c, items: services.filter((s) => s.category === c.id) }));
const filters = [
  { id: 'all', label: 'All' },
  ...categories.map((c) => ({ id: c.id, label: c.filter })),
  { id: 'packages', label: 'Packages' },
];
---

<Base path="/services/">
  <section class="wrap page-top stack" style="gap: clamp(28px, 4vw, 48px)">
    <div class="page-head">
      <div class="stack">
        <p class="eyebrow eyebrow--rule">{services.length} services</p>
        <h1 class="display h-page">Facial menu <em>and prices</em></h1>
      </div>
      <p class="lede">
        Every service on the booking menu, with its price, length and deposit up front. New here? Start with the{' '}
        <a href="/services/new-client-signature/">New Client Signature Facial</a>, or see{' '}
        <a href="/which-facial/">which facial fits your skin concern</a>.
      </p>
    </div>

    <div class="chips chips--row" role="group" aria-label="Filter the menu" data-filter>
      {
        filters.map((f, i) => (
          <button class="chip" type="button" data-goal={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}
          </button>
        ))
      }
    </div>

    {
      groups.map((g) => (
        <section class="group" id={g.id} data-group={g.id}>
          <h2 class="display h-sub">{g.name}</h2>
          {g.note && <p class="group__note muted">{g.note}</p>}
          <div class="cards">
            {g.items.map((s) => (
              <article class="svc">
                <a class="svc__photo" href={`/services/${s.slug}/`} tabindex="-1">
                  <Image
                    src={images[s.image].src}
                    alt={images[s.image].alt}
                    quality={images[s.image].quality}
                    widths={[420, 800]}
                    sizes="(min-width: 1100px) 400px, (min-width: 740px) 50vw, 100vw"
                    style={`object-position: ${s.focus}`}
                  />
                </a>
                <div class="svc__body">
                  <div class="svc__head">
                    <h3>
                      <a href={`/services/${s.slug}/`}>{s.name}</a>
                    </h3>
                    <span class="svc__price">{s.price}</span>
                  </div>
                  <p class="svc__time">
                    {s.time}
                    {s.deposit && ` · ${s.deposit}`}
                  </p>
                  <p class="svc__desc">{s.lead}</p>
                  {s.bestFor && <p class="small muted">Best for: {s.bestFor}.</p>}
                  <div class="actions">
                    <a class="btn btn--sm" href={site.bookingUrl}>
                      Book <Arrow />
                    </a>
                    <a class="link" href={`/services/${s.slug}/`}>
                      See details<span class="sr-only">: {s.name}</span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <section class="group" id="packages" data-group="packages">
      <h2 class="display h-sub">Packages</h2>
      <div class="cards">
        {
          packages.map((p) => (
            <article class="svc" id={p.id}>
              <div class="svc__photo">
                <Image
                  src={images[p.image].src}
                  alt={images[p.image].alt}
                  quality={images[p.image].quality}
                  widths={[420, 800]}
                  sizes="(min-width: 1100px) 400px, (min-width: 740px) 50vw, 100vw"
                />
              </div>
              <div class="svc__body">
                <div class="svc__head">
                  <h3>{p.name}</h3>
                  <span class="svc__price">{p.price}</span>
                </div>
                <p class="svc__time">
                  {p.sessions} · {packageDeposit}
                </p>
                <p class="svc__desc">{p.desc}</p>
                <p class="small muted">{p.value}</p>
                <div class="actions">
                  <a class="btn btn--sm" href={site.bookingUrl}>
                    Book <Arrow />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
        <div class="addons">
          <h3>Package add-ons</h3>
          <dl>
            {
              packageAddOns.map((a) => (
                <div>
                  <dt>{a.name}</dt>
                  <dd>{a.desc}</dd>
                </div>
              ))
            }
          </dl>
          <p class="small muted">{packageAddOnNote}</p>
          <p class="small muted">{packageTerms}</p>
        </div>
      </div>
    </section>

    <p class="muted" style="max-width: 760px">
      Book takes you to my booking site, where you pick your time. Open days aren’t always open times, so check there
      for what’s available. The booking screen has the final price and deposit for each service. First-visit questions
      are on the <a href="/faq/">FAQ</a>.
    </p>
  </section>
  <CtaBand />
</Base>

<style>
  .page-top {
    padding-block: clamp(28px, 4vw, 56px) var(--section);
  }

  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 64px;
  }

  .page-head > p {
    max-width: 460px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 24px;
    scroll-margin-top: 24px;
    transition: opacity 0.4s ease;
  }

  .chips--row {
    flex-wrap: nowrap;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter, 20px) * -1);
    padding-inline: var(--gutter, 20px);
    margin-block: -8px;
    padding-block: 4px;
  }

  .chips--row::-webkit-scrollbar {
    display: none;
  }

  .chips--row .chip {
    flex: none;
    min-height: 44px;
    padding: 0 18px;
  }

  .group__note {
    max-width: 70ch;
    margin-top: -8px;
  }

  .group.is-dim {
    display: none;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 28px;
  }

  .svc {
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border: 1px solid #e6dccd;
    border-radius: 28px;
    overflow: hidden;
    scroll-margin-top: 24px;
  }

  .svc__photo {
    position: relative;
    display: block;
    height: 300px;
    overflow: hidden;
  }

  .svc__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .svc:hover .svc__photo :global(img) {
    transform: scale(1.04);
  }

  .svc__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px 28px 28px;
  }

  .svc__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }

  .svc__head h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.05;
  }

  .svc__head h3 a {
    text-decoration: none;
  }

  .svc__price {
    flex: none;
    font-family: var(--serif);
    font-size: 30px;
    line-height: 1;
    color: var(--bronze);
  }

  .svc__time {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .svc__desc {
    flex: 1;
    color: var(--text);
  }

  .addons {
    padding: 28px;
    background: var(--sand);
    border-radius: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .addons h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.05;
  }

  .addons dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .addons dt {
    font-weight: 500;
  }

  .addons dd {
    margin: 0;
    font-size: 15px;
    color: var(--text-strong);
  }
</style>

<script>
  // Category filter. Every service stays in the HTML; picking a category hides the other groups.
  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((bar) => {
    const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-goal]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const goal = chip.dataset.goal;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        groups.forEach((g) => g.classList.toggle('is-dim', goal !== 'all' && g.dataset.group !== goal));
      }),
    );
  });
</script>
