---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Arrow from '../components/Arrow.astro';
import { concerns } from '../data/concerns';
import { serviceBySlug } from '../data/facials';
import { images } from '../data/images';
import { site } from '../data/site';

const path = '/which-facial/';
const title = 'Which Facial Is Right for My Skin? | Golden State Glam';
const description =
  'Clogged pores, breakouts, dull skin, puffiness or razor irritation? See which facial at Golden State Glam in Fair Oaks fits each concern, with prices.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Facials', item: `${site.url}/services/` },
      { '@type': 'ListItem', position: 3, name: 'Which facial', item: `${site.url}${path}` },
    ],
  },
];
---

<Base path={path} title={title} description={description} jsonLd={jsonLd}>
  <section class="which-hero bg-sand">
    <div class="wrap which-hero__in">
      <div class="which-hero__text stack">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/services/">Facials</a><span>/</span><span>Which facial</span>
        </nav>
        <h1 class="display h-page">Which facial is right <em>for your skin?</em></h1>
        <p class="lede">
          Find what’s bothering your skin and see the facial I’d point you to, with its price and length. Still not
          sure? <a href={site.smsHref}>Text me</a> and I’ll help you choose.
        </p>
      </div>
      <div class="which-hero__photos" aria-hidden="true">
        {
          ['glassSkin', 'facialMask', 'sculptDrain'].map((k) => (
            <Image src={images[k].src} alt="" widths={[240, 480]} sizes="(min-width: 900px) 200px, 30vw" loading="eager" />
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap which">
    <div class="which__grid">
      {
        concerns.map((c, i) => {
          const first = serviceBySlug(c.services[0]);
          const last = i === concerns.length - 1;
          return (
            <article class:list={['concern', { 'concern--dark': last }]} id={c.id}>
              <div class="concern__photo">
                <Image
                  src={images[first.image].src}
                  alt={images[first.image].alt}
                  quality={images[first.image].quality}
                  widths={[420, 640, 840]}
                  sizes="(min-width: 900px) 420px, 100vw"
                  style={`object-position: ${first.focus}`}
                />
                <span class="concern__num">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="concern__body">
                <h2>{c.title}</h2>
                <p>{c.text}</p>
                <ul>
                  {c.services.map((slug) => {
                    const s = serviceBySlug(slug);
                    return (
                      <li>
                        <a href={`/services/${s.slug}/`}>
                          <span class="concern__name">{s.name}</span>
                          <span class="concern__meta">
                            {s.price} · {s.time}
                          </span>
                          <Arrow />
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="muted small which__note">
      Facials here are cosmetic skincare, not medical treatment, and results vary. Severe or painful acne, a rash, or
      a mole or spot that’s changing is best seen by a dermatologist first.
    </p>
  </section>
  <CtaBand />
</Base>

<style>
  .which-hero {
    border-radius: 0 0 clamp(28px, 4vw, 56px) clamp(28px, 4vw, 56px);
  }

  .which-hero__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px clamp(32px, 6vw, 88px);
    padding-block: clamp(16px, 2.5vw, 32px) clamp(36px, 5vw, 64px);
  }

  .which-hero__text {
    flex: 1 1 420px;
    min-width: 0;
    gap: 18px;
  }

  .which-hero__photos {
    flex: 1 1 380px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(10px, 1.4vw, 18px);
    align-items: center;
  }

  .which-hero__photos :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4.4;
    object-fit: cover;
    border-radius: 999px;
  }

  .which-hero__photos :global(img:nth-child(2)) {
    margin-top: clamp(24px, 4vw, 56px);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 14px;
    color: var(--text);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .crumbs span {
    display: inline-flex;
    align-items: center;
  }

  .which {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 48px);
    padding-block: clamp(36px, 5vw, 72px) var(--section);
  }

  .which__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(400px, 100%), 1fr));
    gap: clamp(20px, 2.4vw, 32px);
  }

  .concern {
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 28px;
    overflow: hidden;
    scroll-margin-top: 96px;
  }

  .concern__photo {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--sand);
  }

  .concern__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .concern__num {
    position: absolute;
    left: 16px;
    top: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--champagne);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 20px;
  }

  .concern__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
    padding: clamp(20px, 2.4vw, 28px);
    color: var(--text-strong);
  }

  .concern h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(26px, 2.4vw, 32px);
    line-height: 1.1;
    color: var(--ink);
  }

  .concern ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
    padding-top: 4px;
  }

  .concern li a {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px 14px;
    min-height: 56px;
    padding: 10px 18px;
    background: var(--sand);
    border-radius: 16px;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.2s ease;
  }

  .concern li a:hover {
    background: var(--champagne);
  }

  .concern__name {
    flex: 1 1 0;
    min-width: 0;
    font-family: var(--serif);
    font-size: 21px;
    line-height: 1.15;
  }

  .concern__meta {
    order: 3;
    flex-basis: 100%;
    font-size: 14px;
    color: var(--text-strong);
  }

  .concern li a :global(svg) {
    flex: none;
  }

  .concern--dark {
    background: var(--ink);
    border-color: var(--ink);
  }

  .concern--dark h2 {
    color: var(--champagne);
  }

  .concern--dark .concern__body {
    color: var(--ivory);
  }

  .concern--dark li a {
    background: var(--champagne);
  }

  .concern--dark li a:hover {
    background: var(--ivory);
  }

  .which__note {
    max-width: 60ch;
  }

  @media (max-width: 700px) {
    .which-hero__photos {
      order: -1;
      flex-basis: 100%;
      max-width: 340px;
      margin-inline: auto;
    }

    .which-hero__photos :global(img) {
      aspect-ratio: 3 / 3.6;
    }

    .which-hero__in {
      padding-top: 20px;
    }
  }
</style>
